{
    // 1. 파이썬 경로 지정 (아까 확인한 경로가 맞는지 확인!)
    "python.defaultInterpreterPath": "C:\\ProgramData\\miniconda3\\envs\\travel-ai\\python.exe",

    // 2. 터미널 프로필 설정 (여기가 핵심 ⭐)
    "terminal.integrated.profiles.windows": {
        "TravelAI PowerShell": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "conda activate travel-ai" // 터미널 켜지자마자 이 명령어 실행!
            ]
        }
    },

    // 3. 위에서 만든 프로필을 기본값으로 지정
    "terminal.integrated.defaultProfile.windows": "TravelAI PowerShell"
}