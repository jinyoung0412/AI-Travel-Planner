# Copy to repository-root .env only for authorized external features.
# Leave blank for offline tests; never commit credentials.
ANTHROPIC_API_KEY=
KAKAO_API_KEY=
# Optional separate REST key for route APIs; falls back to KAKAO_API_KEY.
KAKAO_ROUTE_REST_API_KEY=
NAVER_API_ID=
NAVER_API_SECRET=
# Optional crawler CSV directory; leave unset to use the repository default.
# TRAVEL_DATA_DIR=/absolute/path/to/chungnam_data

# Optional runtime configuration (defaults shown; leave commented to use them).
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5001
# FLASK_DEBUG=false
# PLACES_DB_PATH=Flask_server/places.db
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# LLM_TIMEOUT_SECONDS=4
# FLASK_BASE_URL=http://127.0.0.1:5001
# FLASK_TIMEOUT_MS=30000
# NODE_HOST=127.0.0.1
# NODE_PORT=8080
# PORT is a fallback when NODE_PORT is unset.
# CORS_ORIGINS=http://localhost:3000
# Flutter: --dart-define=API_BASE_URL=http://10.0.2.2:8080 (not read from .env).
